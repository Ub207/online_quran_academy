# Rename this file to secrets.toml and fill in your Groq API key.
# Get your free API key from: https://console.groq.com
#
# IMPORTANT: keep GROQ_API_KEY at the TOP LEVEL (no [section] header).
# The app reads st.secrets["GROQ_API_KEY"] directly, so a [secrets] header would hide it.
# On Streamlit Community Cloud, paste this same top-level line into Settings -> Secrets.

GROQ_API_KEY = "your_groq_api_key_here"
